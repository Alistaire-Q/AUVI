# ── LLM Configuration (Modular — untuk analisis klip) ──
# Secara default menggunakan Groq.
# Untuk beralih provider, ubah 3 variabel di bawah saja:
#
# GROQ (default, gratis):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=  (otomatis pakai GROQ_API_KEY jika kosong)
#   LLM_MODEL=llama-3.3-70b-versatile
#
# OPENROUTER (gratis):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-xxxxx
#   LLM_MODEL=meta-llama/llama-3-70b-instruct:free
#
# OLLAMA (lokal, gratis):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
