# Get your free API key at: https://console.groq.com
GROQ_API_KEY=

# LLM API Key (used by analyzer.py - falls back to GROQ_API_KEY if not set)
LLM_API_KEY=

# LLM Configuration (optional - defaults to Groq llama-3.3-70b-versatile)
LLM_BASE_URL=
LLM_MODEL=

# Storage path (optional - defaults to ./storage)
STORAGE_PATH=

# Supabase (PostgreSQL) Database URL
# Get this from your Supabase Project Settings -> Database -> Connection String
DATABASE_URL=

# Google OAuth 2.0 Credentials (for YouTube Automation)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URL for Google OAuth callback (Must match exactly what is in Google Cloud Console)
GOOGLE_REDIRECT_URI=
FRONTEND_URL=

# Redis Configuration (Required for ARQ Background Worker)
# Upstash Redis (https://upstash.com) is recommended for serverless deployment
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL=
